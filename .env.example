APP_NAME=IPTV Aggregator API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://iptv:iptv@localhost:5432/iptv
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["*"]
CREATE_TABLES_ON_STARTUP=true
SQL_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
IMPORT_BATCH_SIZE=500
MAX_IMPORT_BYTES=52428800
MAX_FAILURE_DETAILS=200
STREAM_VALIDATION_CONCURRENCY=150
STREAM_VALIDATION_TIMEOUT_SECONDS=8.0
STREAM_VALIDATION_ORIGIN=http://127.0.0.1:8000
CHANNEL_CACHE_TTL_SECONDS=60
DEMO_MODE=false
SEED_DEMO_DATA=false
DEMO_CHANNEL_COUNT=6
SEED_PUBLIC_CATALOG=false
TV_PUBLIC_MODE=false
ENABLE_MAC_STALKER_PORTAL=false
PUBLIC_CATALOG_NAME=IPTV-org Worldwide
PUBLIC_CATALOG_URL=https://iptv-org.github.io/iptv/index.m3u
ALLOW_SERVER_FILE_IMPORT=false
ALLOWED_IMPORT_ROOT=./imports
ADMIN_API_KEY=
SUBSCRIBER_BASE_URL=http://127.0.0.1:8000
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
